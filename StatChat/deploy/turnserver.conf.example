# Copy to the coturn host and replace placeholders through deployment secrets.
listening-port=3478
tls-listening-port=5349
fingerprint
lt-cred-mech
realm=turn.example.com
server-name=turn.example.com
cert=/etc/coturn/tls/fullchain.pem
pkey=/etc/coturn/tls/privkey.pem
min-port=49160
max-port=49200
no-cli
no-multicast-peers
no-loopback-peers
log-file=stdout

# Supply the credential without committing it:
# user=statchat:<generated-secret>
