{
  "dashboard": {
    "id": null,
    "uid": "statgate-basic",
    "title": "StatGate Basic Overview",
    "panels": [
      {
        "type": "graph",
        "title": "HTTP Request Rate",
        "targets": [
          {
            "expr": "sum(rate(statgate_http_requests_total[1m])) by (method)",
            "legendFormat": "{{method}}"
          }
        ],
        "gridPos": {"x": 0, "y": 0, "w": 12, "h": 6}
      },
      {
        "type": "graph",
        "title": "HTTP Request Latency (95th)",
        "targets": [
          {
            "expr": "histogram_quantile(0.95, sum(rate(statgate_http_request_duration_seconds_bucket[5m])) by (le))",
            "legendFormat": "p95"
          }
        ],
        "gridPos": {"x": 12, "y": 0, "w": 12, "h": 6}
      },
      {
        "type": "graph",
        "title": "Ingest Volume (events/sec)",
        "targets": [
          {
            "expr": "sum(rate(statgate_ingest_events_total[5m]))",
            "legendFormat": "ingest/sec"
          }
        ],
        "gridPos": {"x": 0, "y": 6, "w": 12, "h": 6}
      },
      {
        "type": "graph",
        "title": "ABAC Denials (per reason)",
        "targets": [
          {
            "expr": "sum(rate(statgate_abac_denials_total[5m])) by (reason)",
            "legendFormat": "{{reason}}"
          }
        ],
        "gridPos": {"x": 12, "y": 6, "w": 12, "h": 6}
      },
      {
        "type": "graph",
        "title": "DB Pool Usage (in-use / max)",
        "targets": [
          {
            "expr": "(statgate_db_pool_in_use / statgate_db_pool_max) * 100",
            "legendFormat": "pool %"
          }
        ],
        "gridPos": {"x": 0, "y": 12, "w": 24, "h": 6}
      }
    ],
    "schemaVersion": 16,
    "version": 0
  }
}
