FROM node:20-alpine
WORKDIR /app
RUN echo "const express = require('express'); const app = express(); app.get('/', (req, res) => res.json({status: 'ok'})); app.listen(3000, () => console.log('Running on 3000'));" > server.js
RUN npm init -y && npm install express
EXPOSE 3000
CMD ["node", "server.js"]
